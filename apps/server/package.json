{
  "name": "@dsh-cloud/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:local": "node --env-file=.env.local --import tsx --watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @dsh-cloud/instance-spec build",
    "test": "vitest run",
    "test:security": "DSH_SECURITY_INTEGRATION=1 vitest run src/db/instance-repo.integration.test.ts src/instance/traefik.integration.test.ts",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "spike": "tsx scripts/spike-instance.ts",
    "check:storage": "tsx scripts/check-storage.ts",
    "migrate:img": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-to-img.ts"
  },
  "dependencies": {
    "@dsh-cloud/instance-spec": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "better-auth": "^1.7.3",
    "cookie": "^1.1.1",
    "dockerode": "^4.0.4",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "microsandbox": "^0.6.18",
    "postgres": "^3.4.9",
    "yaml": "^2.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.34",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
