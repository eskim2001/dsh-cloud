# dsh-cloud 控制面配置。复制成 apps/server/.env.local（开发）或填进 compose 的 environment（生产）。
# 校验规则见 apps/server/src/env.ts，缺必填项进程直接起不来。

# ── 必填 ────────────────────────────────────────────────────────────────
# 说明：下面这套是「生产 / 本地入口栈」的形态。若只是本地起管理台
# （Vite 在 localhost:5173、没有入口），改成 BASE_DOMAIN=localhost、
# PUBLIC_SCHEME=http、EXTRA_TRUSTED_ORIGINS=http://localhost:5173，
# 否则 better-auth 会以 403 INVALID_ORIGIN 拒绝管理台的请求。

# Postgres 连接串
DATABASE_URL=postgres://dshcloud:dshcloud@127.0.0.1:55432/dsh_cloud

# 实例子域挂在它下面：<slug>.app.example.com
BASE_DOMAIN=app.example.com

# 派生实例桥的 gate token（每实例一把，D8 ③）。轮换后必须重建实例容器，否则桥 403。
# 生成：openssl rand -hex 32
PLATFORM_SECRET=

# 签会话 cookie。与 PLATFORM_SECRET 分开——密钥轮换的影响面不同，不该共用一把。
# 生成：openssl rand -hex 32
BETTER_AUTH_SECRET=

# 实例容器基础镜像（pin 到 digest 见 instance-spec 的 isPinnedImage）
INSTANCE_IMAGE=dsh-instance:0.1.0

# ── 有默认值 ────────────────────────────────────────────────────────────
# 控制面监听端口（只绑回环，由入口接入）
PORT=3000

# 生成对外 URL 用
PUBLIC_SCHEME=https

# 用户能在实例详情页自助升级到的版本，逗号分隔的精确 tag。
# 只写「平台已回归过」的 tag；空 = 用户不能自选版本（升级由管理员做）。
INSTANCE_STABLE_IMAGES=

# 额外受信来源，逗号分隔。better-auth 校验 Origin；前端跑在别的端口时要显式放行。
EXTRA_TRUSTED_ORIGINS=

# 入口容器名（Traefik）。控制面把它接进每个实例网络，实例容器才够得着它（D3）。
TRAEFIK_CONTAINER=dsh-ingress

# 实例路由挂的 entryPoint。生产是 websecure（TLS 终结在 Traefik）。
TRAEFIK_ENTRYPOINT=websecure

# 实例 router 用的 ACME resolver 名（对应 traefik.yml 的 certificatesResolvers）。
# 留空 = 不挂 resolver，证书走 file provider 的静态证书按 SNI 匹配（本地 mkcert 是这一档）。
TRAEFIK_CERT_RESOLVER=

# 平台管理员邮箱，逗号分隔。启动时把已存在的这些账号提权为 admin（只升不降）。
ADMIN_EMAILS=

# 每个用户默认能开几个实例；单用户覆盖值在 user.instance_quota。
MAX_INSTANCES_PER_USER=3

# 宿主上存放实例数据文件系统的目录。每实例一个 <storage_key>.img（大小 = 磁盘配额），
# 挂到 <root>/<storage_key> 再 bind 进容器当 /data。旧实例迁移后保留原 slug 路径。
HOST_STORAGE_ROOT=/var/lib/dsh

# 执行宿主存储操作的助手镜像（nsenter 进宿主跑 losetup/mkfs.ext4/mount 那几条）
STORAGE_HELPER_IMAGE=alpine:3.20

# ── 只在开发/特殊部署下用（env.ts 之外，直接读 process.env） ─────────────
# 控制面渲染给 Traefik 的动态路由文件（真相源是 DB）
# TRAEFIK_ROUTES_PATH=/etc/traefik/dynamic/routes.yml
# 入口调 forward-auth 的地址。入口在容器里、控制面在宿主上时才需要显式给。
# FORWARD_AUTH_ADDRESS=http://host.docker.internal:3000/auth/verify
